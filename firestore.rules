rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isMasterCreator() {
      return isSignedIn() && (
        request.auth.token.email == 'boisersteavenkinth@gmail.com' ||
        request.auth.token.email == 'boisersteavenkinth@deped.gov.ph'
      );
    }

    // --- System / Connection Verification ---
    match /_system_/{docId} {
      allow read: if true;
    }

    // --- Upgrades Manifest ---
    match /system_upgrades/{upgradeId} {
      allow read: if isSignedIn();
      allow create, update: if isMasterCreator();
    }

    // --- Master Creator Secure Backup Vault ---
    match /MasterCreatorVault/{docId} {
      allow read, write: if isSignedIn();
    }

    // --- Action Research Guidelines ---
    match /action_research_policies/{policyId} {
      allow read, write: if isSignedIn();
    }

    // --- Grading Sheets ---
    match /grading_sheets/{sheetId} {
      allow read, write: if isSignedIn();
    }

    // --- Security Alerts & Monitoring ---
    match /securityAlerts/{alertId} {
      allow create: if true; // allow system or client to log security triggers
      allow read: if isSignedIn() && (resource.data.sourceIpOrUser == request.auth.token.email || isMasterCreator());
    }

    // --- Activity Monitoring Logs ---
    match /activityLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.userEmail == request.auth.token.email || isMasterCreator());
    }

    // --- System Notifications ---
    match /notifications/{notifId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isMasterCreator());
    }

    // --- Saved Project Drafts & Vault ---
    match /auditLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if isMasterCreator();
    }

    match /projects/{projectId} {
      allow read, write: if isSignedIn() && (resource.data.ownerId == request.auth.uid || incoming().ownerId == request.auth.uid || isMasterCreator());
    }

    match /worksheets/{worksheetId} {
      allow read, write: if isSignedIn();
    }

    match /barcodeRecords/{recordId} {
      allow read, write: if isSignedIn() && (resource.data.ownerId == request.auth.uid || incoming().ownerId == request.auth.uid || isMasterCreator());
    }

    // --- Users Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'school', 'updatedAt'])
        );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 256))
        && (data.school == null || (data.school is string && data.school.size() <= 256));
    }

    // --- Answer Keys ---
    match /users/{userId}/answerKeys/{keyId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(keyId) && isValidAnswerKey(incoming());
      allow update: if isOwner(userId) && isValidId(keyId) && isValidAnswerKey(incoming());
      allow delete: if isOwner(userId);
    }

    function isValidAnswerKey(data) {
      return data.keys().hasAll(['id', 'title', 'items'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.items is list && data.items.size() <= 200;
    }

    // --- Batches ---
    match /users/{userId}/batches/{batchId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(batchId) && isValidBatch(incoming());
      allow update: if isOwner(userId) && isValidId(batchId) && isValidBatch(incoming());
      allow delete: if isOwner(userId);
    }

    function isValidBatch(data) {
      return data.keys().hasAll(['id', 'name', 'answerKeyId'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.answerKeyId is string && data.answerKeyId.size() <= 128;
    }

    // --- Student Grades ---
    match /users/{userId}/batches/{batchId}/studentGrades/{studentId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(batchId) && isValidId(studentId) && isValidStudentGrade(incoming());
      allow update: if isOwner(userId) && isValidId(batchId) && isValidId(studentId) && isValidStudentGrade(incoming());
      allow delete: if isOwner(userId);
    }

    function isValidStudentGrade(data) {
      return data.keys().hasAll(['id', 'name', 'gradingResult'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.gradingResult is map;
    }
  }
}
